.cache/

# dni-share: nunca subir claves, base de datos ni archivos subidos
dni-share/data/
dni-share/*.db
dni-share/*.db-journal
dni-share/*.db-wal
dni-share/*.db-shm
dni-share/.key
dni-share/__pycache__/

# Binarios de Codelabs: pesan ~9 MB cada uno y no se sirven desde el sitio.
# El toolchain de claat solo se necesita para regenerar codelabs; no versionar.
**/claat-*.exe
.claat/

# Backups locales y archivos de copia temporal. NUNCA versionar:
# - pueden contener código obsoleto con fallos de seguridad ya parcheados
# - GitHub Pages los serviría como páginas válidas
# - exponen HTML previo a scrapers y a comparadores tipo "antes/después"
*.bak
*.bak.*
*.backup
*.old
*.orig
*.rej
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# Configuración local de asistentes de IA. No versionar.
.claude/
.continue/
.opencode/
