.cache/

# dni-share: nunca subir claves, base de datos ni archivos subidos
dni-share/data/
dni-share/*.db
dni-share/*.db-journal
dni-share/*.db-wal
dni-share/*.db-shm
dni-share/.key
dni-share/__pycache__/

# Binarios de Codelabs: pesan ~9 MB cada uno y no se sirven desde el sitio.
# El toolchain de claat solo se necesita para regenerar codelabs; no versionar.
**/claat-*.exe
.claat/

# Backups locales y archivos de copia temporal. NUNCA versionar:
# - pueden contener código obsoleto con fallos de seguridad ya parcheados
# - GitHub Pages los serviría como páginas válidas
# - exponen HTML previo a scrapers y a comparadores tipo "antes/después"
*.bak
*.bak.*
*.backup
*.old
*.orig
*.rej
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# Configuración local de Claude Code (.claude/settings.json, hooks, etc.).
# Por defecto se ignora todo el directorio. La triple excepción mantiene
# las skills locales versionadas como muestra de transparencia del proceso
# de auditoría ("audit before you trust"):
#   1. !.claude/         → desactiva el ignore raíz
#   2. !.claude/skills/  → reactiva el directorio de skills
#   3. !.claude/skills/**→ reactiva el contenido de cada skill
# Sin las tres, git seguiría ignorando los archivos nuevos dentro de
# .claude/skills/ porque el patrón ".claude/" los matchea recursivamente
# antes de evaluar la excepción. Si en el futuro una skill concreta
# contiene credenciales o código ejecutable no auditable, debe ignorarse
# individualmente (con un patrón más específico).
.claude/
!.claude/
!.claude/skills/
!.claude/skills/**

# Configuración local de Continue IDE (.continue/mcpServers/*.yaml con
# tokens, .continue/index/ con SQLite, .continue/dev_data/ con telemetría).
# Por defecto se ignora todo el directorio, igual que .claude/. NO hay
# excepciones: ningún YAML con apiKey o GITHUB_MCP_TOKEN debe llegar al
# repo público de GitHub Pages. Si en el futuro quieres versionar una
# configuración de Continue sin secretos, muévela a .continue/templates/
# y añádela como excepción explícita.
.continue/
